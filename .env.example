# Valores de configuración, no credenciales. Completar con recursos ya aprobados.
GCP_PROJECT_ID=geglobal-level-program
GCP_LOCATION=us-central1
GCS_BUCKET=knowledge-agent-cap
GEMINI_MODEL=gemini-2.5-flash
AGENT_SEARCH_LOCATION=global
AGENT_SEARCH_APP_ID=knowledge-agent-search_1792367963658
AGENT_SEARCH_SERVING_CONFIG=default_search
AGENT_SEARCH_DATA_STORE_ID=knowledge-agent-rag_1792366120415

# Optional: SharePoint Online import via Microsoft Graph. Requires an Entra ID application with the
# application permission Sites.Read.All (or Sites.Selected). Leave empty to hide the SharePoint panel.
# Put the real values in .env only; never commit the secret.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
